# PowerPredict TL - copy to .env and adjust
# Serving database (XAMPP MariaDB / MySQL). SQLite also works:
#   PP_DB_URL=sqlite:///data/powerpredict.db
PP_DB_URL=mysql+pymysql://root:@localhost:3306/powerpredict_db?charset=utf8mb4

# Kafka (KRaft, single broker)
PP_KAFKA_HOME=C:\kafka\kafka_2.13-3.9.1
PP_KAFKA_BOOTSTRAP=localhost:9092
PP_KAFKA_TOPIC=smart-meter-readings
PP_KAFKA_PARTITIONS=3

# Spark
PP_SPARK_MASTER=local[*]
PP_SPARK_DRIVER_MEMORY=12g

# Data lake location (raw CSV + curated Parquet). Default: ./data inside the project.
# The 5GB + 10GB + 20GB datasets need ~55 GB, so they can live on another disk:
#   PP_DATA_DIR=D:\powerpredict-data
# Spark spill / shuffle folder (default: system temp on C:)
#   PP_SPARK_LOCAL_DIR=D:\powerpredict-data\spark-tmp

# Streaming
PP_PRODUCER_INTERVAL_SECONDS=2
PP_STREAM_TRIGGER_SECONDS=3
PP_LIVE_FLEET_SIZE=300

# Website (Streamlit dashboard)
PP_DASHBOARD_PORT=8505

# Website login - first accounts, created once when tbl_users is empty (choose your own passwords).
# Later accounts are managed in the website: Admin -> Jestaun Uzuáriu.
PP_ADMIN_USERNAME=admin
PP_ADMIN_PASSWORD=
PP_USER_USERNAME=operador
PP_USER_PASSWORD=
